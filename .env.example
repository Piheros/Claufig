# Copy this file to .env.local and fill in your values
# Never commit .env.local — it contains your secrets

# Your Figma Personal Access Token
# Generate one at: figma.com → Settings → Personal access tokens
FIGMA_TOKEN=figd_your_token_here

# Your Figma Team ID
# Find it in your Figma team URL: figma.com/files/team/{TEAM_ID}/...
FIGMA_TEAM_ID=your_team_id_here
